@page
@model Chats.Pages.Settings.ApiProviderModel
@{
    ViewData["Title"] = "APIプロバイダー設定";
}

<div class="row">
    <div class="col-md-8 offset-md-2 content-container">
        <h2>@ViewData["Title"]</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["Message"]
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <h3>Gemini</h3>
            <div class="form-group mb-3">
                <label asp-for="GeminiSettings.ApiKey"></label>
                <input asp-for="GeminiSettings.ApiKey" class="form-control" />
                <span asp-validation-for="GeminiSettings.ApiKey" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="GeminiSettings.ModelText"></label>
                <textarea asp-for="GeminiSettings.ModelText" class="form-control" rows="5"></textarea>
                <span asp-validation-for="GeminiSettings.ModelText" class="text-danger"></span>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary me-2">保存</button>
            </div>
        </form>
    </div>
</div>
