@page
@model Chats.Pages.Admin.Users.EditModel
@using Chats.Data
@{
    ViewData["Title"] = "ユーザー編集";
}
@section Scripts {
    <script src="~/Pages/Admin/Users/Edit.cshtml.js" asp-append-version="true" defer></script>
}

<div class="row">
    <div class="col-md-8 offset-md-2 content-container">
        <h2>@ViewData["Title"]</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />
            <div class="form-group mb-3">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Input.DisplayName"></label>
                <input asp-for="Input.DisplayName" class="form-control" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Input.Role"></label><br />
                @foreach (var role in Enum.GetValues(typeof(UserRole)).Cast<UserRole>().Where(r => r != UserRole.None))
                {
                    <div class="form-check form-check-inline">
                        <input type="checkbox"
                               class="form-check-input"
                               id="@($"Input_Role_{(int)role}")"
                               name="Input.Role"
                               value="@((int)role)"
                               @( (Model.Input.Role & role) == role ? "checked" : "" ) />
                        <label class="form-check-label" for="@($"Input_Role_{(int)role}")">@role.ToString()</label>
                    </div>
                }
                <span asp-validation-for="Input.Role" class="text-danger"></span>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary me-2">保存</button>
                <a asp-page="./Index" class="btn btn-secondary">一覧に戻る</a>
            </div>
        </form>

        <div class="mt-4">
            <h3>パスワードリセット</h3>
            <button type="button" id="resetPasswordButton" class="btn btn-warning" data-user-id="@Model.Input.Id">パスワードをリセット</button>
            <div id="passwordDisplayArea" style="display:none; margin-top: 15px;">
                <label for="generatedPassword">新しいパスワード:</label>
                <div class="input-group">
                    <input type="text" id="generatedPassword" class="form-control" readonly />
                    <button type="button" id="copyPasswordButton" class="btn btn-outline-secondary">コピー</button>
                </div>
            </div>
        </div>
    </div>
</div>
