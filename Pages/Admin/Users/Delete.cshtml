@page
@model Chats.Pages.Admin.Users.DeleteModel
@using Chats.Data
@{
    ViewData["Title"] = "ユーザー削除";
}
<div class="row">
    <div class="col-md-8 offset-md-2 content-container">
        <h3>このユーザーを削除してもよろしいですか？</h3>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DisplayUser.Id" />
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.DisplayUser.Email)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.DisplayUser.Email)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.DisplayUser.DisplayName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.DisplayUser.DisplayName)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.DisplayUser.Role)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.DisplayUser.Role)
                </dd>
            </dl>
            <div class="mt-3">
                <button type="submit" class="btn btn-danger me-2">削除</button>
                <a asp-page="./Index" class="btn btn-secondary">一覧に戻る</a>
            </div>
        </form>
    </div>
</div>
